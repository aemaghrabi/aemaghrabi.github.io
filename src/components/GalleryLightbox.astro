---
// Gallery option B: a cover card per project; opening one shows its screens full size in a <dialog>.
import { gallery } from '../data/gallery';
import { clientName } from '../lib/clientName';

const SHOWN_TAGS = 5;
---

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  {
    gallery.map((p) => (
      <button
        type="button"
        class="group block w-full cursor-pointer border-0 bg-transparent p-0 text-left text-ink"
        data-lightbox-open={p.id}
        aria-haspopup="dialog"
        aria-label={`Open ${p.title} screenshots`}
      >
        <span class="card block overflow-hidden p-0 transition-colors group-hover:border-accent md:p-0">
          <img
            class="block aspect-[16/10] w-full border-b border-line object-cover object-left-top"
            src={p.images[0].src}
            alt={p.images[0].caption}
            width={p.images[0].width}
            height={p.images[0].height}
            loading="lazy"
            decoding="async"
          />
          <span class="flex flex-col gap-2.5 p-6">
            <span class="eyebrow text-soft">{clientName(p.client)}</span>
            <span class="h3">{p.title}</span>
            <span class="text-base text-soft">{p.description}</span>
            <span class="flex flex-wrap gap-2">
              {p.tags.slice(0, SHOWN_TAGS).map((t) => <span class="pill">{t}</span>)}
              {p.tags.length > SHOWN_TAGS && <span class="pill">+{p.tags.length - SHOWN_TAGS}</span>}
            </span>
            <span class="mt-1.5 inline-flex items-center gap-2 font-bold text-accent">
              View {p.images.length} screens
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
            </span>
          </span>
        </span>
      </button>
    ))
  }
</div>

{
  gallery.map((p) => (
    <dialog
      id={`lightbox-${p.id}`}
      class="m-auto h-dvh max-h-none w-dvw max-w-none bg-night/95 p-0 text-paper backdrop:bg-night/70"
      aria-label={`${p.title} screenshots`}
      data-lightbox
    >
      <div class="mx-auto flex h-full max-w-[1200px] flex-col items-center justify-center gap-5 px-3 py-6 md:px-10 md:py-12">
        <div class="flex w-full items-center justify-between gap-4">
          <span class="text-xl font-bold">{p.title}</span>
          <button type="button" class="min-h-11 cursor-pointer rounded-pill border border-paper/40 bg-transparent px-[18px] text-[15px] text-paper" data-close>
            Close
          </button>
        </div>
        <div class="flex w-full min-h-0 flex-1 items-center gap-4">
          <button type="button" class="lightbox-btn" data-prev aria-label="Previous screenshot">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5" /><path d="M11 6l-6 6 6 6" /></svg>
          </button>
          <div class="flex h-full min-w-0 flex-1 items-center justify-center">
            {p.images.map((im, j) => (
              <img
                class:list={['max-h-full max-w-full rounded-xl object-contain', j !== 0 && 'hidden']}
                src={im.src}
                alt={im.caption}
                width={im.width}
                height={im.height}
                loading="lazy"
                decoding="async"
                data-slide={j}
              />
            ))}
          </div>
          <button type="button" class="lightbox-btn" data-next aria-label="Next screenshot">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
          </button>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-4 text-teal-mist">
          <span class="font-mono text-sm" data-count aria-live="polite">1 / {p.images.length}</span>
          <span class="text-[15px]" data-caption>{p.images[0].caption}</span>
        </div>
        <div class="grid w-full max-w-[720px] grid-cols-3 gap-2.5 sm:grid-cols-6">
          {p.images.map((im, j) => (
            <button
              type="button"
              class="block cursor-pointer overflow-hidden rounded-[10px] border-2 border-transparent bg-transparent p-0 leading-none aria-pressed:border-teal-bright"
              data-thumb={j}
              aria-pressed={j === 0 ? 'true' : 'false'}
              aria-label={im.caption}
            >
              <img class="block aspect-[16/10] w-full object-cover object-left-top" src={im.src} alt="" loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      </div>
    </dialog>
  ))
}

<script is:inline>
  document.querySelectorAll('[data-lightbox]').forEach(function (dlg) {
    var slides = dlg.querySelectorAll('[data-slide]');
    var thumbs = dlg.querySelectorAll('[data-thumb]');
    var count = dlg.querySelector('[data-count]');
    var caption = dlg.querySelector('[data-caption]');
    var n = slides.length, i = 0;
    function show(k) {
      i = (k + n) % n;
      slides.forEach(function (s, j) { s.classList.toggle('hidden', j !== i); });
      thumbs.forEach(function (t, j) { t.setAttribute('aria-pressed', j === i ? 'true' : 'false'); });
      count.textContent = (i + 1) + ' / ' + n;
      caption.textContent = slides[i].getAttribute('alt');
    }
    dlg.querySelector('[data-prev]').addEventListener('click', function () { show(i - 1); });
    dlg.querySelector('[data-next]').addEventListener('click', function () { show(i + 1); });
    dlg.querySelector('[data-close]').addEventListener('click', function () { dlg.close(); });
    thumbs.forEach(function (t) { t.addEventListener('click', function () { show(+t.getAttribute('data-thumb')); }); });
    dlg.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
    dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
    dlg.show0 = show;
  });
  document.querySelectorAll('[data-lightbox-open]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var dlg = document.getElementById('lightbox-' + btn.getAttribute('data-lightbox-open'));
      dlg.show0(0);
      dlg.showModal();
    });
  });
</script>
